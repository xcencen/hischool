# Private service settings; store real values at F:/my-campus-dev/config/mcp.env.
# This secret must be independent of CAMPUS_JWT_SECRET. No model key is needed here.
CAMPUS_MCP_SIGNING_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
CAMPUS_MCP_URL=http://campus-mcp:8001/mcp
CAMPUS_MCP_TOKEN_TTL_S=60
CAMPUS_MCP_QUERY_TIMEOUT_S=10
CAMPUS_MCP_KNOWLEDGE_TIMEOUT_S=55
