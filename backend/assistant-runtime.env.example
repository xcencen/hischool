# Explicit M3 policy; keep real configuration outside Git on F:/my-campus-dev/config/.
# Enable both only after the campus data export decision. No fake-data product mode.
CAMPUS_ASSISTANT_ENABLED=false
CAMPUS_ASSISTANT_ALLOW_CAMPUS_DATA=false
CAMPUS_ASSISTANT_RETENTION_DAYS=7
CAMPUS_ASSISTANT_RUN_COST_LIMIT_CNY=0.10
CAMPUS_ASSISTANT_USER_DAILY_LIMIT_CNY=1
CAMPUS_ASSISTANT_GLOBAL_DAILY_LIMIT_CNY=5
CAMPUS_ASSISTANT_ALERT_RATIO=0.8
CAMPUS_ASSISTANT_USER_CONCURRENCY=1
CAMPUS_ASSISTANT_GLOBAL_CONCURRENCY=2
CAMPUS_ASSISTANT_RUN_TIMEOUT_S=180
CAMPUS_ASSISTANT_QUEUE_TIMEOUT_S=120
CAMPUS_ASSISTANT_LEASE_S=30
CAMPUS_ASSISTANT_CONTEXT_TURNS=8
CAMPUS_ASSISTANT_CONTEXT_MAX_BYTES=48000
CAMPUS_ASSISTANT_MAX_MODEL_CALLS=4
CAMPUS_ASSISTANT_MAX_TOOL_CALLS=6
CAMPUS_ASSISTANT_MAX_PARALLEL_TOOLS=3
CAMPUS_ASSISTANT_MAX_RETRIES=1
# Beijing text-embedding-v4 input price, CNY/million tokens; operator-reviewed version.
CAMPUS_ASSISTANT_EMBED_PRICE_PER_1M=0.5
CAMPUS_ASSISTANT_EMBED_PRICE_VERSION=bailian-beijing-2026-10-29
