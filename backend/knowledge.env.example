# Copy to F:/my-campus-dev/config/knowledge.env locally. Never commit real keys.
CAMPUS_EMBED_API_KEY=
# Use the Beijing compatible base URL from your Bailian workspace console.
CAMPUS_EMBED_BASE_URL=
CAMPUS_EMBED_MODEL_ID=text-embedding-v4
CAMPUS_EMBED_DIM=1024
# Optional; Docker uses shared /data/knowledge and /data/faiss volumes.
# CAMPUS_KB_MIN_SCORE=0.3
