# my-campus initialization settings (optional).
# The bootstrap application reads process environment variables only.
# It does not load .env automatically, including the existing legacy .env.
APP_NAME=my-campus
APP_VERSION=0.1.0
# Comma-separated origins for direct frontend development requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Step 2: explicit campus runtime. Never load the legacy backend/.env.
# Compose injects these values from the separate root .env.compose.
APP_MODE=bootstrap
# CAMPUS_DATABASE_URL=mysql+asyncmy://my_campus:REPLACE_ME@127.0.0.1:13306/my_campus?charset=utf8mb4
# CAMPUS_REDIS_URL=redis://127.0.0.1:16379/0
# CAMPUS_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# CAMPUS_DEMO_ADMIN_PASSWORD=REPLACE_ME
# CAMPUS_DEMO_TEACHER_PASSWORD=REPLACE_ME
# CAMPUS_DEMO_STUDENT_PASSWORD=REPLACE_ME

# Future stages only: model/MCP/FAISS are NOT enabled in this step.
# Never commit a real .env, database password, JWT secret, or model API key.
# MODEL_PROVIDER=bailian
# MODEL_REGION=cn-beijing
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=deepseek-v4.1-flash
# DASHSCOPE_API_KEY=REPLACE_ME
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
# MCP_HOST=127.0.0.1
# MCP_PORT=8001
# MCP_PATH=/mcp
# FAISS_INDEX_DIR=./data/faiss
