# my-campus initialization settings (optional).
# The bootstrap application reads process environment variables only.
# It does not load .env automatically, including the existing legacy .env.
APP_NAME=my-campus
APP_VERSION=0.1.0
# Comma-separated origins for direct frontend development requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Future stages only: these integrations are NOT enabled in this step.
# Never commit a real .env, database password, JWT secret, or model API key.
# DATABASE_URL=mysql+asyncmy://my_campus:REPLACE_ME@127.0.0.1:3306/my_campus?charset=utf8mb4
# REDIS_URL=redis://127.0.0.1:6379/0
# JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
# MODEL_PROVIDER=bailian
# MODEL_REGION=cn-beijing
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=deepseek-v4.1-flash
# DASHSCOPE_API_KEY=REPLACE_ME
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
# MCP_HOST=127.0.0.1
# MCP_PORT=8001
# MCP_PATH=/mcp
# FAISS_INDEX_DIR=./data/faiss
