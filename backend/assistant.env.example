# Copy outside the repository to F:/my-campus-dev/config/assistant.env.
# Process variables only. Never read backend/.env or reuse embedding credentials implicitly.
CAMPUS_LLM_MODEL_ID=deepseek-v4.1-flash-1017
CAMPUS_LLM_BASE_URL=
CAMPUS_LLM_API_KEY=
CAMPUS_LLM_TIMEOUT_S=30
CAMPUS_LLM_MAX_OUTPUT_TOKENS=2048
CAMPUS_LLM_ENABLE_THINKING=false

# Fill ALL prices from the applicable billing page before a live probe.
# Units: CNY / 1,000,000 tokens. No implicit discount or free-price defaults.
CAMPUS_LLM_PRICE_CURRENCY=CNY
CAMPUS_LLM_PRICE_INPUT_PER_1M=
CAMPUS_LLM_PRICE_OUTPUT_PER_1M=
CAMPUS_LLM_PRICE_CACHE_READ_PER_1M=
CAMPUS_LLM_PRICE_VERSION=
CAMPUS_LLM_PRICE_SOURCE=
