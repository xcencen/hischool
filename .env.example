# Use scripts/setup_local.py to create a separate ignored .env.compose.
# Do not copy or overwrite backend/.env (legacy database configuration).
CAMPUS_DATA_ROOT=F:/my-campus-dev/data
CAMPUS_DB_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
CAMPUS_DB_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_PASSWORD
# The password here must match CAMPUS_DB_PASSWORD; URL-encode special characters.
CAMPUS_DATABASE_URL=mysql+asyncmy://my_campus:REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD@mysql:3306/my_campus?charset=utf8mb4
CAMPUS_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CAMPUS_DEMO_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
CAMPUS_DEMO_TEACHER_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
CAMPUS_DEMO_STUDENT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# Optional Step 7 M1 settings are documented in backend/assistant.env.example.
# Store real chat settings outside the repository in F:/my-campus-dev/config/assistant.env.
